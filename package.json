{
  "name": "decipool-contracts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Decipool contracts: the pool factory and the deployment, verification and fork-test tooling.",
  "dependencies": {
    "@acala-network/chopsticks": "^1.5.1",
    "@polkadot/api": "16",
    "@polkadot/keyring": "14",
    "@polkadot/util": "14",
    "@polkadot/util-crypto": "14",
    "solc": "0.8.30",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "deepmerge-ts": "^8.0.2",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "scripts": {
    "compile": "bun compile.ts",
    "test:fork": "bun factory-test.ts",
    "test:pool": "bun test.ts",
    "check": "bun check-upstream.ts && bun compile.ts && tsc --noEmit",
    "typecheck": "tsc --noEmit"
